{
  "name": "idea-checker",
  "version": "1.0.0",
  "description": "Find and validate digital-product niches (Richard Yu's 4-source method)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/main.ts\" \"vite\"",
    "dev:mock": "IDEA_CHECKER_MOCK=1 npm run dev",
    "start:api": "tsx server/main.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "smoke:sources": "tsx scripts/smoke-sources.ts"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "private": "true"
}
