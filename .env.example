# Copy to .env and fill in. Never commit .env.

# Claude API key from https://console.anthropic.com (billed per use, separate from a Claude subscription)
ANTHROPIC_API_KEY=

# Reddit "script" app from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit asks for a descriptive user agent: <platform>:<app id>:<version> (by /u/<your reddit username>)
REDDIT_USER_AGENT=macos:idea-checker:0.1.0 (by /u/your_username)

# Optional
# IDEA_CHECKER_MODEL=claude-opus-5-5
# IDEA_CHECKER_PORT=3001
# IDEA_CHECKER_DATA_DIR=data
# IDEA_CHECKER_MOCK=1   # use saved fixtures instead of Reddit/Google/Claude
